#!/bin/sh
# Fast checks before every commit (lint, typecheck, unit tests).
# The full run (build, e2e) happens in the stop gate and in CI.
# Installed by: git config core.hooksPath .githooks
node .claude/scripts/verify.mjs --quick --hook || {
  echo ""
  echo "pre-commit: quick checks failed. Fix them, then commit again."
  exit 1
}
